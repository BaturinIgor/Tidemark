    "0 none, 1 mild, 2 moderate, 3 severe.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "0 ingen, 1 let, 2 moderat, 3 svær."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 keine, 1 leicht, 2 mittel, 3 stark."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 none, 1 mild, 2 moderate, 3 severe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 nada, 1 leve, 2 moderado, 3 fuerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "0 ei oireita, 1 lievä, 2 kohtalainen, 3 vaikea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0 aucun, 1 léger, 2 modéré, 3 sévère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "0 nessuno, 1 lieve, 2 moderato, 3 forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0 なし、1 軽い、2 中くらい、3 強い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0 없음, 1 약함, 2 중간, 3 심함."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "0 ingen, 1 lett, 2 middels, 3 kraftig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 geen, 1 licht, 2 matig, 3 ernstig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "0 brak, 1 łagodne, 2 umiarkowane, 3 silne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "0 nenhum, 1 leve, 2 moderado, 3 forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "0 нет, 1 слабо, 2 умеренно, 3 сильно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "0 inga, 1 lätt, 2 måttlig, 3 svår."
          }
        },
