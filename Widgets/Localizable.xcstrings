    "One line at the top of the report, in your words.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én linje øverst i rapporten, med dine ord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile oben im Bericht, in deinen Worten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One line at the top of the report, in your words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea al principio del informe, con tus palabras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi rivi raportin alussa, omin sanoin."
