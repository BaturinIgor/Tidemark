    "We couldn't verify the purchase with the App Store. You were not charged twice; try Restore.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten den Kauf beim App Store nicht bestätigen. Dir wurde nichts doppelt berechnet; versuch Wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify the purchase with the App Store. You were not charged twice; try Restore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar la compra con el App Store. No se te cobró dos veces; prueba Restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier l’achat auprès de l’App Store. Vous n’avez pas été débitée deux fois ; essayez Restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a verificare l’acquisto con l’App Store. Non ti è stato addebitato due volte; prova Ripristina."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden de aankoop niet controleren bij de App Store. Er is niet dubbel afgeschreven; probeer Herstel."
          }
        }
      }
    },
    "We found your Tidemark backup in iCloud. Your check-ins, questionnaires, medicines and questions will come back to this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben dein Tidemark-Backup in iCloud gefunden. Deine Check-ins, Fragebögen, Medikamente und Fragen kommen zurück auf dieses iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found your Tidemark backup in iCloud. Your check-ins, questionnaires, medicines and questions will come back to this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos tu copia de Tidemark en iCloud. Tus registros, cuestionarios, medicamentos y preguntas volverán a este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé votre sauvegarde Tidemark dans iCloud. Vos suivis, questionnaires, médicaments et questions vont revenir sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo trovato il tuo backup Tidemark in iCloud. Registrazioni, questionari, farmaci e domande torneranno su questo iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben je Tidemark-back-up in iCloud gevonden. Je check-ins, vragenlijsten, medicijnen en vragen komen terug op deze iPhone."
          }
        }
      }
    },
    "We use your region for terms on the report (%@, %@).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir nutzen deine Region für die Begriffe im Bericht (%@, %@)."
          }
        },
