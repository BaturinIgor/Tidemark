    "Next, iOS will ask to allow notifications.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derefter spørger iOS, om notifikationer må vises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes fragt iOS, ob Mitteilungen erlaubt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, iOS will ask to allow notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación, iOS te pedirá permitir notificaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavaksi iOS pyytää sallimaan ilmoitukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, iOS vous demandera d’autoriser les notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi iOS ti chiederà di consentire le notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このあと、iOSが通知の許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음으로 iOS가 알림 허용 여부를 물어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deretter spør iOS om å tillate varsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna vraagt iOS of meldingen zijn toegestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz iOS poprosi o zgodę na powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, o iOS vai pedir para permitir notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дальше iOS спросит разрешение на уведомления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan frågar iOS om notiser får visas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırada iOS bildirimlere izin vermeni isteyecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来，iOS 会询问是否允许通知。"
          }
        }
      }
    },
