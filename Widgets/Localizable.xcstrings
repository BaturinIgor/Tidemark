    "Do I need a blood test, or can we decide based on my symptoms?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har jeg brug for blodprøver, eller kan vi beslutte ud fra mine gener?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauche ich eine Blutuntersuchung, oder können wir anhand meiner Beschwerden entscheiden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do I need a blood test, or can we decide based on my symptoms?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Necesito un análisis de sangre o podemos decidir según mis síntomas?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitsenko verikokeita, vai voimmeko päättää oireiden perusteella?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai-je besoin d'une prise de sang, ou pouvons-nous décider à partir de mes symptômes ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho bisogno di esami del sangue o possiamo decidere in base ai sintomi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "血液検査は必要ですか？それとも症状から判断できますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혈액 검사가 필요한가요, 아니면 증상으로 판단할 수 있나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenger jeg blodprøver, eller kan vi bestemme ut fra plagene mine?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb ik bloedonderzoek nodig, of kunnen we op basis van mijn klachten beslissen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy potrzebuję badań krwi, czy możemy zdecydować na podstawie objawów?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preciso de exame de sangue ou podemos decidir com base nos meus sintomas?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны ли мне анализы крови или можно решить по симптомам?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behöver jag ta blodprov, eller kan vi bestämma utifrån mina besvär?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan tahlili gerekir mi, yoksa belirtilerime göre karar verebilir miyiz?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我需要验血吗，还是可以根据症状来判断？"
          }
        }
      }
    },
