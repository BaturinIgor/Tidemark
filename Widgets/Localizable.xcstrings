        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 장짜리 PDF를 저장해 인쇄하거나, 이메일로 보내거나, 병원 포털에 올리세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
