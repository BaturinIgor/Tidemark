    "Fill them in while you remember. You can add up to %lld days back, so the report stays honest.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udfyld dem, mens du husker det. Du kan gå op til %lld dage tilbage, så rapporten forbliver ærlig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag sie nach, solange du dich erinnerst. Du kannst bis zu %lld Tage zurück nachtragen, damit der Bericht ehrlich bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill them in while you remember. You can add up to %lld days back, so the report stays honest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétalos mientras te acuerdas. Puedes añadir hasta %lld días atrás, para que el informe sea fiel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täytä ne, kun vielä muistat. Voit lisätä enintään %lld päivää taaksepäin, jotta raportti pysyy rehellisenä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétez-les tant que vous vous en souvenez. Vous pouvez remonter jusqu’à %lld jours, pour que le rapport reste fidèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completali finché te li ricordi. Puoi tornare indietro fino a %lld giorni, così il resoconto resta fedele."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えているうちに入力しましょう。レポートを正確に保つため、さかのぼれるのは%lld日までです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억날 때 채워 두세요. 리포트가 정확하도록 최대 %lld일 전까지 추가할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll dem inn mens du husker. Du kan gå opptil %lld dager tilbake, så rapporten blir ærlig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul ze in nu je het nog weet. Je kunt tot %lld dagen terug invullen, zodat het rapport eerlijk blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzupełnij je, póki pamiętasz. Możesz cofnąć się maksymalnie o %lld dni, żeby raport był rzetelny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha enquanto se lembra. Você pode voltar até %lld dias, para o relatório continuar fiel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполните, пока помните. Можно вернуться назад максимум на %lld дн., чтобы отчет оставался честным."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll i dem medan du minns. Du kan gå upp till %lld dagar bakåt, så att rapporten blir ärlig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlarken doldur. Raporun dürüst kalması için en fazla %lld gün geriye ekleyebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "趁还记得赶快补填。最多可补填 %lld 天前的记录，确保报告真实可信。"
          }
        }
      }
    },
