    "Overall burden per day. Darker means a harder day.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samlet belastning per dag. Mørkere betyder en hårdere dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtbelastung pro Tag. Dunkler heißt: ein schwererer Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overall burden per day. Darker means a harder day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga total por día. Más oscuro significa un día más difícil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokonaiskuormitus päivässä. Tummempi tarkoittaa raskaampaa päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge globale par jour. Plus foncé signifie une journée plus difficile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carico complessivo al giorno. Più scuro significa una giornata più pesante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日ごとの全体的な負担。色が濃いほどつらい日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 전체 부담. 색이 진할수록 힘든 날이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samlet belastning per dag. Mørkere betyr en tyngre dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totale belasting per dag. Donkerder betekent een zwaardere dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączne obciążenie dnia. Ciemniejszy oznacza trudniejszy dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga total por dia. Mais escuro significa um dia mais difícil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общая нагрузка за день. Чем темнее, тем тяжелее день."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Total belastning per dag. Mörkare betyder en tyngre dag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük toplam yük. Koyu renk daha zor bir gün demek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天的总体负担。颜色越深表示那天越难熬。"
          }
        }
      }
    },
