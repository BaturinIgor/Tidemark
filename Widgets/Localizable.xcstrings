    "**Report ready:** %lld check-ins, %lld questionnaires, %lld questions saved.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rapporten er klar:** %lld registreringer, %lld spørgeskemaer, %lld spørgsmål gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bericht fertig:** %lld Check-ins, %lld Fragebögen, %lld Fragen gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Report ready:** %lld check-ins, %lld questionnaires, %lld questions saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Informe listo:** %lld registros, %lld cuestionarios, %lld preguntas guardadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Raportti valmis:** %lld kirjausta, %lld kyselyä, %lld kysymystä tallennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rapport prêt :** %lld suivis, %lld questionnaires, %lld questions enregistrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Resoconto pronto:** %lld registrazioni, %lld questionari, %lld domande salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**レポート準備完了：**記録%lld回、質問票%lld回、質問%lld件を保存済み。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**리포트 준비 완료:** 기록 %lld회, 설문 %lld회, 질문 %lld개 저장됨."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rapporten er klar:** %lld registreringer, %lld skjemaer, %lld spørsmål lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rapport klaar:** %lld check-ins, %lld vragenlijsten, %lld vragen bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Raport gotowy.** Wpisy: %lld, kwestionariusze: %lld, zapisane pytania: %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Relatório pronto:** %lld registros, %lld questionários, %lld perguntas salvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Отчет готов.** Отметок: %lld, анкет: %lld, вопросов сохранено: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rapporten är klar:** %lld incheckningar, %lld formulär, %lld frågor sparade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rapor hazır:** %lld kayıt, %lld anket, %lld soru kaydedildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**报告已就绪：** 已保存 %lld 次记录、%lld 份问卷、%lld 个问题。"
          }
        }
      }
    },
    "**Your data stays yours.** Saved on this phone and backed up, encrypted, to your own iCloud. No account, no ads, no data sales.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dine data er dine.** Gemt på denne telefon og sikkerhedskopieret, krypteret, til din egen iCloud. Ingen konto, ingen reklamer, intet salg af data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Deine Daten gehören dir.** Auf diesem Telefon gespeichert und verschlüsselt in deiner eigenen iCloud gesichert. Kein Konto, keine Werbung, kein Datenverkauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Your data stays yours.** Saved on this phone and backed up, encrypted, to your own iCloud. No account, no ads, no data sales."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tus datos son tuyos.** Guardados en este teléfono y con copia cifrada en tu propio iCloud. Sin cuenta, sin anuncios, sin venta de datos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tietosi ovat sinun.** Tallennettu tähän puhelimeen ja varmuuskopioitu salattuna omaan iCloudiisi. Ei tiliä, ei mainoksia, ei tietojen myyntiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vos données vous appartiennent.** Enregistrées sur ce téléphone et sauvegardées, chiffrées, dans votre propre iCloud. Pas de compte, pas de pub, pas de revente de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**I tuoi dati restano tuoi.** Salvati su questo telefono e copiati, cifrati, nel tuo iCloud. Nessun account, niente pubblicità, nessuna vendita di dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**あなたのデータはあなたのもの。** このiPhoneに保存され、ご自身のiCloudに暗号化してバックアップされます。アカウント不要、広告なし、データ販売なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**내 데이터는 내 것이에요.** 이 휴대폰에 저장되고 내 iCloud에 암호화되어 백업돼요. 계정 없음, 광고 없음, 데이터 판매 없음."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dataene dine er dine.** Lagret på denne telefonen og sikkerhetskopiert, kryptert, til din egen iCloud. Ingen konto, ingen reklame, ikke noe salg av data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Je gegevens blijven van jou.** Bewaard op deze telefoon en versleuteld geback-upt in je eigen iCloud. Geen account, geen advertenties, geen verkoop van gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Twoje dane należą do Ciebie.** Zapisane na tym telefonie i zaszyfrowane w kopii w Twoim własnym iCloud. Bez konta, bez reklam, bez sprzedaży danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Seus dados são seus.** Salvos neste celular e com backup criptografado no seu próprio iCloud. Sem conta, sem anúncios, sem venda de dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ваши данные принадлежат вам.** Хранятся на этом телефоне и в зашифрованной копии в вашем собственном iCloud. Без аккаунта, без рекламы, без продажи данных."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Din data är din.** Sparas på den här telefonen och säkerhetskopieras krypterat till din egen iCloud. Inget konto, ingen reklam, ingen försäljning av data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Verilerin sana ait.** Bu telefonda saklanır ve şifrelenerek kendi iCloud'una yedeklenir. Hesap yok, reklam yok, veri satışı yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**你的数据属于你。** 保存在这部手机上，并加密备份到你自己的 iCloud。无需账户，无广告，不出售数据。"
          }
        }
      }
    },
