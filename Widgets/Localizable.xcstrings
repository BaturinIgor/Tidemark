        }
      }
    },
    "Rate today only, not the worst day of the week. Missed a day? You can fill it in later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerte nur heute, nicht den schlimmsten Tag der Woche. Einen Tag verpasst? Du kannst ihn später nachtragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate today only, not the worst day of the week. Missed a day? You can fill it in later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valora solo hoy, no el peor día de la semana. ¿Te saltaste un día? Puedes completarlo luego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez seulement aujourd’hui, pas le pire jour de la semaine. Un jour manqué ? Vous pourrez le compléter plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta solo oggi, non il giorno peggiore della settimana. Hai saltato un giorno? Puoi completarlo dopo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beoordeel alleen vandaag, niet de slechtste dag van de week. Een dag gemist? Je kunt hem later invullen."
          }
        }
      }
    },
