    },
    "We will have your report ready the day before. Two weeks of check-ins is enough for a useful picture.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben deinen Bericht am Tag davor fertig. Zwei Wochen Check-ins reichen für ein brauchbares Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will have your report ready the day before. Two weeks of check-ins is enough for a useful picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendremos tu informe listo el día antes. Dos semanas de registros bastan para una imagen útil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rapport sera prêt la veille. Deux semaines de suivi suffisent pour avoir une image utile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il resoconto sarà pronto il giorno prima. Due settimane di registrazioni bastano per un quadro utile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben je rapport de dag ervoor klaar. Twee weken check-ins is genoeg voor een bruikbaar beeld."
          }
        }
      }
    },
    "We will mark this visit on your charts so the next report shows before and after.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir markieren diesen Termin in deinen Diagrammen, damit der nächste Bericht ein Vorher und Nachher zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will mark this visit on your charts so the next report shows before and after."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcaremos esta cita en tus gráficos para que el próximo informe muestre el antes y el después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous marquerons ce rendez-vous sur vos graphiques pour que le prochain rapport montre l’avant et l’après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segneremo questa visita nei grafici, così il prossimo resoconto mostrerà il prima e il dopo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We markeren dit bezoek in je grafieken, zodat het volgende rapport het verschil voor en na laat zien."
          }
        }
      }
    },
