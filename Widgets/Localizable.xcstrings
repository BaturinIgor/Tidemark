    "This can take a minute on a new iPhone. Keep the app open.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan tage et minut på en ny iPhone. Hold appen åben."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem neuen iPhone kann das eine Minute dauern. Lass die App geöffnet."
