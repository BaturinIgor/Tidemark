    "One tap saves a hot flush with the time.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét tryk gemmer en hedetur med tidspunktet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp speichert eine Hitzewallung mit Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap saves a hot flush with the time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque guarda un sofoco con la hora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi napautus tallentaa kuuman aallon kellonajan kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche enregistre une bouffée de chaleur avec l’heure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco salva una vampata con l’ora."
          }
        },
        "ja": {
