    "Tag factors in your check-in. Patterns show up after at least %lld days with a tag.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér faktorer i din registrering. Mønstre vises efter mindst %lld dage med en markering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Faktoren in deinem Check-in. Muster erscheinen nach mindestens %lld Tagen mit einer Markierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag factors in your check-in. Patterns show up after at least %lld days with a tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca factores en tu registro. Los patrones aparecen tras al menos %lld días con una etiqueta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse tekijöitä kirjaukseesi. Kuviot näkyvät, kun merkintä on ollut vähintään %lld päivänä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des facteurs dans votre suivi. Les tendances apparaissent après au moins %lld jours avec un facteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi fattori nella registrazione. Gli andamenti compaiono dopo almeno %lld giorni con un fattore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録に要因のタグを付けましょう。タグ付きの日が%lld日以上たまると傾向が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에 요인 태그를 붙이세요. 태그가 붙은 날이 %lld일 이상이면 패턴이 나타나요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk faktorer i registreringen. Mønstre vises etter minst %lld dager med en merking."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer factoren in je check-in. Patronen verschijnen na minstens %lld dagen met een markering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczaj czynniki we wpisie. Wzorce pojawią się po co najmniej %lld dniach z oznaczeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque fatores no seu registro. Os padrões aparecem depois de pelo menos %lld dias com uma marcação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечайте факторы в отметке. Закономерности появятся минимум через %lld дн. с отметкой фактора."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagga faktorer i din incheckning. Mönster visas efter minst %lld dagar med en tagg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydında etkenleri etiketle. Örüntüler, bir etiketle en az %lld gün olduktan sonra görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在记录中标记因素。某个标记至少出现 %lld 天后，规律就会显示。"
          }
        }
      }
    },
    "Tags help you spot what happens together. They show up in Patterns after 5 days.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeringer hjælper dig med at se, hvad der sker samtidig. De vises under Mønstre efter 5 dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markierungen zeigen dir, was zusammen auftritt. Sie erscheinen nach 5 Tagen unter Muster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags help you spot what happens together. They show up in Patterns after 5 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas te ayudan a ver qué ocurre a la vez. Aparecen en Patrones tras 5 días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkinnät auttavat näkemään, mitkä asiat esiintyvät yhdessä. Ne näkyvät Kuviot-kohdassa 5 päivän jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les facteurs aident à repérer ce qui arrive ensemble. Ils apparaissent dans Tendances après 5 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fattori ti aiutano a vedere cosa succede insieme. Compaiono in Andamenti dopo 5 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグで、一緒に起きていることが見えてきます。5日後に「傾向」に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그로 함께 일어나는 일을 알아볼 수 있어요. 5일 뒤 패턴에 나타나요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkinger hjelper deg å se hva som skjer samtidig. De vises under Mønstre etter 5 dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeringen helpen je te zien wat samen voorkomt. Ze verschijnen na 5 dagen bij Patronen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczenia pomagają zobaczyć, co występuje razem. Pojawiają się we Wzorcach po 5 dniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As marcações ajudam a ver o que acontece junto. Elas aparecem em Padrões depois de 5 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метки помогают заметить, что происходит вместе. Они появятся в «Закономерностях» через 5 дней."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taggar hjälper dig se vad som hänger ihop. De visas under Mönster efter 5 dagar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketler birlikte olanları fark etmene yardım eder. 5 gün sonra Örüntüler'de görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记能帮你发现哪些事情会同时出现。5 天后会显示在“规律”中。"
          }
        }
      }
    },
