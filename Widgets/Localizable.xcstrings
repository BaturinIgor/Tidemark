    "Is there anything else we should rule out, such as thyroid or iron levels?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er der andet, vi bør udelukke, fx stofskiftet eller jernniveauet?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollten wir andere Ursachen ausschließen, etwa Schilddrüse oder Eisenwerte?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is there anything else we should rule out, such as thyroid or iron levels?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Hay algo más que debamos descartar, como la tiroides o el hierro?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitäisikö jotain muuta sulkea pois, kuten kilpirauhanen tai rautataso?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faut-il écarter d'autres causes, comme la thyroïde ou le taux de fer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è altro da escludere, come la tiroide o i livelli di ferro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "甲状腺や鉄分など、ほかに確認すべきことはありますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갑상선이나 철분 수치처럼 확인해야 할 다른 원인이 있을까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er det noe annet vi bør utelukke, som skjoldkjertelen eller jernverdier?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moeten we iets anders uitsluiten, zoals de schildklier of ijzertekort?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy powinniśmy wykluczyć inne przyczyny, np. tarczycę lub niedobór żelaza?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há algo mais que devemos descartar, como tireoide ou níveis de ferro?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно ли исключить другие причины, например щитовидную железу или уровень железа?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finns det något annat vi borde utesluta, som sköldkörteln eller järnvärden?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroit veya demir düzeyi gibi dışlamamız gereken başka bir şey var mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否需要排除其他原因，比如甲状腺或铁水平？"
          }
        }
      }
    },
