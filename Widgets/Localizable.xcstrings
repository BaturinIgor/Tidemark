    "What are my treatment options, including %@, and what are the risks for me?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke behandlinger kan jeg få, også hormonbehandling, og hvilke risici er der for mig?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Behandlungsmöglichkeiten gibt es für mich, auch eine Hormontherapie, und welche Risiken haben sie für mich?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are my treatment options, including %@, and what are the risks for me?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué opciones de tratamiento tengo, incluida la terapia hormonal, y qué riesgos tienen para mí?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä hoitovaihtoehtoja minulla on, myös hormonihoito, ja mitä riskejä niihin liittyy minulle?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelles sont mes options de traitement, y compris le traitement hormonal, et quels sont les risques pour moi ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quali opzioni di trattamento ho, compresa la terapia ormonale, e quali rischi ci sono per me?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホルモン補充療法を含め、どんな治療法がありますか？私にとってのリスクは何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호르몬 요법을 포함해 어떤 치료 방법이 있고, 저에게 어떤 위험이 있나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke behandlinger finnes for meg, også hormonbehandling, og hvilke risikoer har de for meg?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke behandelingen zijn er voor mij, ook hormoontherapie, en wat zijn de risico's voor mij?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakie mam możliwości leczenia, w tym hormonalną terapię zastępczą, i jakie wiążą się z nimi ryzyka dla mnie?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quais são minhas opções de tratamento, incluindo terapia hormonal, e quais os riscos para mim?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какие есть варианты лечения, включая ЗГТ, и какие риски они несут для меня?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilka behandlingar finns för mig, även hormonbehandling, och vilka risker finns för mig?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hormon tedavisi dahil hangi tedavi seçeneklerim var ve benim için riskleri neler?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我有哪些治疗选择（包括激素治疗）？对我来说有哪些风险？"
          }
        }
      }
    },
    "What can help with my sleep right now?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad kan hjælpe min søvn lige nu?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was kann mir jetzt beim Schlafen helfen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can help with my sleep right now?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué me puede ayudar a dormir mejor ahora?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä voisi auttaa untani nyt?"
          }
        },
        "fr": {
