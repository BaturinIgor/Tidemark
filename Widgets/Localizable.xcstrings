    "You can ask for a second opinion. Keep checking in and take an updated report to another %@ or a menopause clinic.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst eine zweite Meinung einholen. Mach weiter mit deinen Check-ins und nimm einen aktuellen Bericht zu einer anderen Praxis oder in eine Menopause-Sprechstunde mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can ask for a second opinion. Keep checking in and take an updated report to another %@ or a menopause clinic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pedir una segunda opinión. Sigue registrando y lleva un informe actualizado a otro médico o a una consulta de menopausia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez demander un deuxième avis. Continuez votre suivi et apportez un rapport à jour à un autre médecin ou à une consultation ménopause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi chiedere un secondo parere. Continua a registrare e porta un resoconto aggiornato a un altro medico o a un centro per la menopausa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt om een second opinion vragen. Blijf inchecken en neem een bijgewerkt rapport mee naar een andere arts of een menopauzepoli."
          }
        }
      }
    },
