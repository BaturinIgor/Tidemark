    "Stored on this iPhone and in your own iCloud, encrypted. We never see it. No ads, no data sales.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt på denne iPhone og krypteret i din egen iCloud. Vi ser det aldrig. Ingen reklamer, intet salg af data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone und verschlüsselt in deiner eigenen iCloud gespeichert. Wir sehen es nie. Keine Werbung, kein Datenverkauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored on this iPhone and in your own iCloud, encrypted. We never see it. No ads, no data sales."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardados en este iPhone y en tu propio iCloud, cifrados. Nunca los vemos. Sin anuncios, sin venta de datos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu tähän iPhoneen ja salattuna omaan iCloudiisi. Me emme näe sitä koskaan. Ei mainoksia, ei tietojen myyntiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrées sur cet iPhone et dans votre propre iCloud, chiffrées. Nous ne les voyons jamais. Pas de pub, pas de revente de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvati su questo iPhone e nel tuo iCloud, cifrati. Noi non li vediamo mai. Niente pubblicità, nessuna vendita di dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneとご自身のiCloudに暗号化して保存されます。私たちが見ることはありません。広告なし、データ販売なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone과 내 iCloud에 암호화되어 저장돼요. 저희는 절대 볼 수 없어요. 광고 없음, 데이터 판매 없음."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret på denne iPhonen og kryptert i din egen iCloud. Vi ser det aldri. Ingen reklame, ikke noe salg av data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen op deze iPhone en versleuteld in je eigen iCloud. Wij zien het nooit. Geen advertenties, geen verkoop van gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywane na tym iPhonie i zaszyfrowane w Twoim własnym iCloud. Nigdy ich nie widzimy. Bez reklam, bez sprzedaży danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardados neste iPhone e no seu próprio iCloud, com criptografia. Nós nunca vemos. Sem anúncios, sem venda de dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранятся на этом iPhone и в вашем собственном iCloud в зашифрованном виде. Мы их никогда не видим. Без рекламы, без продажи данных."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparas på den här iPhonen och krypterat i din egen iCloud. Vi ser det aldrig. Ingen reklam, ingen försäljning av data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'da ve kendi iCloud'unda şifreli olarak saklanır. Biz asla görmeyiz. Reklam yok, veri satışı yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密存储在这台 iPhone 和你自己的 iCloud 中。我们永远看不到。无广告，不出售数据。"
          }
        }
      }
    },
