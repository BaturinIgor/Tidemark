    "We couldn't verify the purchase with the App Store. You were not charged twice; try Restore.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekræfte købet hos App Store. Du er ikke blevet trukket to gange; prøv Gendan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten den Kauf beim App Store nicht bestätigen. Dir wurde nichts doppelt berechnet; versuch Wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't verify the purchase with the App Store. You were not charged twice; try Restore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar la compra con el App Store. No se te cobró dos veces; prueba Restaurar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme voineet vahvistaa ostoa App Storesta. Sinua ei veloitettu kahdesti; kokeile Palauta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu vérifier l’achat auprès de l’App Store. Vous n’avez pas été débitée deux fois ; essayez Restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a verificare l’acquisto con l’App Store. Non ti è stato addebitato due volte; prova Ripristina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeで購入を確認できませんでした。二重に請求されてはいません。「復元」をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 구입을 확인하지 못했어요. 두 번 청구되지 않았어요. 복원을 시도해 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fikk ikke bekreftet kjøpet hos App Store. Du er ikke belastet to ganger; prøv Gjenopprett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden de aankoop niet controleren bij de App Store. Er is niet dubbel afgeschreven; probeer Herstel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić zakupu w App Store. Nie pobrano opłaty dwa razy; spróbuj Przywróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a compra com a App Store. Você não foi cobrada duas vezes; tente Restaurar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить покупку в App Store. Повторно деньги не списаны; попробуйте «Восстановить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte bekräfta köpet med App Store. Du har inte debiterats två gånger; prova Återställ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımı App Store ile doğrulayamadık. İki kez ücret alınmadı; Geri yükle'yi dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法通过 App Store 验证此次购买。你没有被重复扣费；请尝试“恢复”。"
          }
        }
      }
    },
    "We found your Tidemark backup in iCloud. Your check-ins, questionnaires, medicines and questions will come back to this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fandt din Tidemark-sikkerhedskopi i iCloud. Dine registreringer, spørgeskemaer, medicin og spørgsmål kommer tilbage til denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben dein Tidemark-Backup in iCloud gefunden. Deine Check-ins, Fragebögen, Medikamente und Fragen kommen zurück auf dieses iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found your Tidemark backup in iCloud. Your check-ins, questionnaires, medicines and questions will come back to this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos tu copia de Tidemark en iCloud. Tus registros, cuestionarios, medicamentos y preguntas volverán a este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löysimme Tidemark-varmuuskopiosi iCloudista. Kirjauksesi, kyselysi, lääkkeesi ja kysymyksesi palaavat tähän iPhoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé votre sauvegarde Tidemark dans iCloud. Vos suivis, questionnaires, médicaments et questions vont revenir sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo trovato il tuo backup Tidemark in iCloud. Registrazioni, questionari, farmaci e domande torneranno su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudにTidemarkのバックアップが見つかりました。記録、質問票、薬、質問がこのiPhoneに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 Tidemark 백업을 찾았어요. 기록, 설문, 약, 질문이 이 iPhone으로 돌아와요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fant Tidemark-sikkerhetskopien din i iCloud. Registreringer, skjemaer, medisiner og spørsmål kommer tilbake til denne iPhonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben je Tidemark-back-up in iCloud gevonden. Je check-ins, vragenlijsten, medicijnen en vragen komen terug op deze iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaleźliśmy Twoją kopię Tidemark w iCloud. Twoje wpisy, kwestionariusze, leki i pytania wrócą na ten iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontramos seu backup do Tidemark no iCloud. Seus registros, questionários, medicamentos e perguntas vão voltar para este iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы нашли вашу копию Tidemark в iCloud. Ваши отметки, анкеты, лекарства и вопросы вернутся на этот iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi hittade din Tidemark-säkerhetskopia i iCloud. Dina incheckningar, formulär, läkemedel och frågor kommer tillbaka till den här iPhonen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud'da Tidemark yedeğini bulduk. Kayıtların, anketlerin, ilaçların ve soruların bu iPhone'a geri gelecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们在 iCloud 中找到了你的 Tidemark 备份。你的记录、问卷、药物和问题会回到这台 iPhone。"
          }
        }
      }
    },
    "We use your region for terms on the report (%@, %@).": {
      "extractionState": "manual",
