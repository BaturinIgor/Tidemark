    "Save the one-page PDF to print, email or upload to your %@'s portal.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem PDF'en på én side for at udskrive, maile eller uploade den til din læges portal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere das einseitige PDF, um es zu drucken, zu mailen oder im Patientenportal hochzuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the one-page PDF to print, email or upload to your %@'s portal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el PDF de una página para imprimirlo, enviarlo por correo o subirlo al portal de tu médico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
