    "Not yet. We will remind you to book in 2 weeks.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke endnu. Vi minder dig om at bestille tid om 2 uger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht. Wir erinnern dich in 2 Wochen daran, einen Termin zu machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet. We will remind you to book in 2 weeks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no. Te recordaremos pedir cita dentro de 2 semanas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä. Muistutamme sinua varaamaan ajan 2 viikon päästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore. Nous vous rappellerons de prendre rendez-vous dans 2 semaines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora. Ti ricorderemo di prenotare tra 2 settimane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだです。2週間後に予約のリマインダーをお送りします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직이요. 2주 뒤에 예약하라고 알려 드릴게요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke ennå. Vi minner deg på å bestille om 2 uker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet. We herinneren je over 2 weken aan het maken van een afspraak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie. Za 2 tygodnie przypomnimy Ci o umówieniu wizyty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não. Vamos lembrar você de marcar em 2 semanas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет. Через 2 недели напомним записаться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte än. Vi påminner dig om att boka om 2 veckor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz değil. 2 hafta sonra randevu almanı hatırlatacağız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有。我们会在 2 周后提醒你预约。"
          }
        }
      }
    },
