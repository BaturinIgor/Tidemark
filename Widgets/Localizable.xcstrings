    "A pattern, not a verdict. Your doctor will see the same numbers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Muster, kein Urteil. Deine Ärztin oder dein Arzt sieht dieselben Zahlen."
          }
        },
        "en": {
