          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人による症状の記録です。診断ではなく、治療を提案するものでもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인이 기록한 증상 기록이에요. 진단이 아니며 치료를 제안하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Egenrapporterte plager. Det er ikke en diagnose og foreslår ingen behandling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelf bijgehouden klachtenoverzicht. Het is geen diagnose en stelt geen behandeling voor."
