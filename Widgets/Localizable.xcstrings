        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada registro añade tus valoraciones a Salud. Editar un día reemplaza lo que Tidemark escribió para ese día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
