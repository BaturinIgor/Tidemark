    },
    "A week of check-ins shows your %@ a pattern, not one bad day. Missed a day? You can fill in the last 3 days from Today.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Woche Check-ins zeigt ein Muster, nicht nur einen schlechten Tag. Einen Tag verpasst? Die letzten 3 Tage kannst du unter Heute nachtragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A week of check-ins shows your %@ a pattern, not one bad day. Missed a day? You can fill in the last 3 days from Today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semana de registros muestra a tu médico un patrón, no un mal día aislado. ¿Te saltaste un día? Puedes completar los últimos 3 días desde Hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une semaine de suivi montre une tendance à votre médecin, pas une seule mauvaise journée. Un jour manqué ? Vous pouvez compléter les 3 derniers jours depuis Aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una settimana di registrazioni mostra al medico un andamento, non una sola giornata storta. Hai saltato un giorno? Puoi completare gli ultimi 3 giorni da Oggi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een week check-ins laat je arts een patroon zien, niet één slechte dag. Een dag gemist? Je kunt de laatste 3 dagen invullen vanuit Vandaag."
          }
        }
      }
    },
