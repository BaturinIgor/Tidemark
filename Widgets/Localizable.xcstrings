    "After each appointment, Today asks how it went. Your notes appear here.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter hver aftale spørger I dag, hvordan det gik. Dine noter vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Termin fragt Heute, wie es gelaufen ist. Deine Notizen erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After each appointment, Today asks how it went. Your notes appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cada cita, Hoy te pregunta cómo fue. Tus notas aparecen aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisen käynnin jälkeen Tänään-näkymä kysyy, miten meni. Muistiinpanosi näkyvät täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après chaque rendez-vous, Aujourd’hui vous demande comment ça s’est passé. Vos notes apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo ogni visita, Oggi ti chiede com’è andata. Le tue note compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受診のあとに「今日」で様子をおたずねします。メモはここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진료가 끝날 때마다 오늘 화면에서 어땠는지 물어봐요. 메모는 여기에 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter hver time spør I dag hvordan det gikk. Notatene dine vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na elke afspraak vraagt Vandaag hoe het ging. Je notities verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po każdej wizycie widok Dziś zapyta, jak poszło. Twoje notatki pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de cada consulta, Hoje pergunta como foi. Suas notas aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После каждого приема экран «Сегодня» спросит, как все прошло. Ваши заметки появятся здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter varje besök frågar I dag hur det gick. Dina anteckningar visas här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her randevudan sonra Bugün ekranı nasıl geçtiğini sorar. Notların burada görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次就诊后，“今天”会问你情况如何。你的笔记会显示在这里。"
          }
        }
      }
    },
