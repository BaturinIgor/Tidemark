    "Rate how today felt for your %lld symptoms. It takes about 30 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Bewerte, wie sich heute dein %lld Symptom angefühlt hat. Das dauert etwa 30 Sekunden."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Bewerte, wie sich heute deine %lld Symptome angefühlt haben. Das dauert etwa 30 Sekunden."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Rate how today felt for your %lld symptom. It takes about 30 seconds."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Rate how today felt for your %lld symptoms. It takes about 30 seconds."
