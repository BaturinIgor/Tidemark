    "Log how you feel in 30 seconds a day. Before your visit, get a one-page summary your doctor can read in a minute.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse in 30 Sekunden am Tag, wie es dir geht. Vor deinem Termin bekommst du eine einseitige Übersicht, die deine Ärztin oder dein Arzt in einer Minute lesen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log how you feel in 30 seconds a day. Before your visit, get a one-page summary your doctor can read in a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra cómo te sientes en 30 segundos al día. Antes de tu cita, obtén un resumen de una página que tu médico puede leer en un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez votre ressenti en 30 secondes par jour. Avant votre rendez-vous, obtenez un résumé d’une page que votre médecin lit en une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra come ti senti in 30 secondi al giorno. Prima della visita, ottieni un riepilogo di una pagina che il medico legge in un minuto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd in 30 seconden per dag bij hoe je je voelt. Krijg voor je afspraak een overzicht van één pagina dat je arts in een minuut leest."
          }
        }
      }
    },
