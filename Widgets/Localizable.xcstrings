    "%lld of %lld check-ins. You can make a report after %lld, but 14 shows your doctor a clear pattern.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld af %lld registreringer. Du kan lave en rapport efter %lld, men 14 viser din læge et tydeligt mønster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld Check-ins. Einen Bericht kannst du ab %lld erstellen, aber 14 zeigen deiner Ärztin oder deinem Arzt ein klares Muster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld check-ins. You can make a report after %lld, but 14 shows your doctor a clear pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld registros. Puedes crear un informe a partir de %lld, pero 14 muestran a tu médico un patrón claro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld kirjausta. Voit tehdä raportin %lld kirjauksen jälkeen, mutta 14 näyttää lääkärille selvän kuvion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld suivis sur %lld. Vous pouvez créer un rapport après %lld, mais 14 montrent un schéma clair à votre médecin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld registrazioni su %lld. Puoi creare un resoconto dopo %lld, ma 14 mostrano al medico un andamento chiaro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録%lld／%lld回。%lld回からレポートを作れますが、14回あると医師にはっきりした傾向が伝わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 %lld/%lld회. %lld회부터 리포트를 만들 수 있지만, 14회면 의사에게 뚜렷한 패턴을 보여줄 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld av %lld registreringer. Du kan lage en rapport etter %lld, men 14 viser legen et tydelig mønster."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld van %lld check-ins. Je kunt een rapport maken na %lld, maar 14 laten je arts een duidelijk patroon zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld z %lld wpisów. Raport możesz utworzyć po %lld, ale 14 pokaże lekarzowi wyraźny wzorzec."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld registros. Você pode gerar um relatório depois de %lld, mas 14 mostram ao seu médico um padrão claro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметок: %lld из %lld. Отчет можно сделать после %lld, но 14 покажут врачу ясную картину."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld av %lld incheckningar. Du kan skapa en rapport efter %lld, men 14 visar din läkare ett tydligt mönster."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld kayıt. %lld kayıttan sonra rapor oluşturabilirsin ama 14 kayıt doktoruna net bir örüntü gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记录 %lld/%lld 次。记录 %lld 次后即可生成报告，但 14 次能让医生看到清晰的规律。"
          }
        }
      }
    },
