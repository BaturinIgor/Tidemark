    "Started %@. Average of your daily ratings, %lld weeks before and after. 0 is none, 3 is severe.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begonnen am %@. Durchschnitt deiner täglichen Bewertungen, %lld Wochen davor und danach. 0 ist keine, 3 ist stark."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Started %@. Average of your daily ratings, %lld weeks before and after. 0 is none, 3 is severe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezó el %@. Media de tus valoraciones diarias, %lld semanas antes y después. 0 es nada, 3 es fuerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencé le %@. Moyenne de vos notes quotidiennes, %lld semaines avant et après. 0 = aucun, 3 = sévère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniziato il %@. Media delle tue valutazioni giornaliere, %lld settimane prima e dopo. 0 è nessuno, 3 è forte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestart op %@. Gemiddelde van je dagelijkse scores, %lld weken ervoor en erna. 0 is geen, 3 is ernstig."
          }
        }
      }
    },
