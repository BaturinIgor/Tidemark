    "Shown on your report so your doctor sees everything you take. We never suggest medicines or doses.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht in deinem Bericht, damit deine Ärztin oder dein Arzt alles sieht, was du nimmst. Wir schlagen nie Medikamente oder Dosierungen vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown on your report so your doctor sees everything you take. We never suggest medicines or doses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en tu informe para que tu médico vea todo lo que tomas. Nunca sugerimos medicamentos ni dosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Figure sur votre rapport pour que votre médecin voie tout ce que vous prenez. Nous ne suggérons jamais de médicaments ni de doses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare nel resoconto, così il medico vede tutto ciò che prendi. Non suggeriamo mai farmaci o dosi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat in je rapport, zodat je arts alles ziet wat je gebruikt. We stellen nooit medicijnen of doseringen voor."
          }
        }
      }
    },
