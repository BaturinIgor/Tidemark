    "Log bleeding in your daily check-in. Cycle lengths appear after two periods.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer blødning i den daglige registrering. Cykluslængder vises efter to menstruationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Blutungen im täglichen Check-in. Zykluslängen erscheinen nach zwei Perioden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log bleeding in your daily check-in. Cycle lengths appear after two periods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra el sangrado en tu registro diario. La duración de los ciclos aparece tras dos reglas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa vuoto päivittäisessä kirjauksessa. Kiertojen pituudet näkyvät kahden kuukautisten jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez les saignements dans votre suivi quotidien. Les durées de cycle apparaissent après deux cycles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra il sanguinamento nella registrazione giornaliera. La durata dei cicli compare dopo due mestruazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出血は毎日の記録で入力してください。生理が2回あると周期の長さが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출혈은 매일 기록에서 입력하세요. 생리가 두 번 기록되면 주기 길이가 나타나요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer blødning i den daglige registreringen. Sykluslengder vises etter to menstruasjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer bloedingen in je dagelijkse check-in. Cycluslengtes verschijnen na twee menstruaties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj krwawienie w codziennym wpisie. Długości cyklu pojawią się po dwóch miesiączkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre o sangramento no registro diário. A duração dos ciclos aparece depois de duas menstruações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечайте кровотечения в ежедневной отметке. Длина цикла появится после двух месячных."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga blödning i den dagliga incheckningen. Cykellängder visas efter två menstruationer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanamayı günlük kaydında gir. Döngü uzunlukları iki adetten sonra görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每日记录中记录出血。记录两次月经后会显示周期长度。"
          }
        }
      }
    },
    "Log how you feel in 30 seconds a day. Before your visit, get a one-page summary your doctor can read in a minute.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer, hvordan du har det, på 30 sekunder om dagen. Før dit besøg får du et resumé på én side, som lægen kan læse på et minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse in 30 Sekunden am Tag, wie es dir geht. Vor deinem Termin bekommst du eine einseitige Übersicht, die deine Ärztin oder dein Arzt in einer Minute lesen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log how you feel in 30 seconds a day. Before your visit, get a one-page summary your doctor can read in a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra cómo te sientes en 30 segundos al día. Antes de tu cita, obtén un resumen de una página que tu médico puede leer en un minuto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa vointisi 30 sekunnissa päivässä. Ennen käyntiä saat yhden sivun yhteenvedon, jonka lääkäri lukee minuutissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez votre ressenti en 30 secondes par jour. Avant votre rendez-vous, obtenez un résumé d’une page que votre médecin lit en une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra come ti senti in 30 secondi al giorno. Prima della visita, ottieni un riepilogo di una pagina che il medico legge in un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日30秒で体調を記録。受診前に、医師が1分で読める1ページのまとめが手に入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 30초로 컨디션을 기록하세요. 진료 전에 의사가 1분 만에 읽을 수 있는 한 장 요약을 받아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer hvordan du har det på 30 sekunder om dagen. Før timen får du et sammendrag på én side som legen leser på ett minutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd in 30 seconden per dag bij hoe je je voelt. Krijg voor je afspraak een overzicht van één pagina dat je arts in een minuut leest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj samopoczucie w 30 sekund dziennie. Przed wizytą dostaniesz jednostronicowe podsumowanie, które lekarz przeczyta w minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre como você se sente em 30 segundos por dia. Antes da consulta, receba um resumo de uma página que o médico lê em um minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечайте самочувствие за 30 секунд в день. Перед приемом получите сводку на одну страницу, которую врач прочитает за минуту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga hur du mår på 30 sekunder om dagen. Före besöket får du en sammanfattning på en sida som läkaren läser på en minut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde 30 saniyede nasıl hissettiğini kaydet. Randevundan önce doktorunun bir dakikada okuyabileceği tek sayfalık bir özet al."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天花 30 秒记录感受。就诊前获得一页摘要，医生一分钟就能读完。"
          }
        }
      }
    },
