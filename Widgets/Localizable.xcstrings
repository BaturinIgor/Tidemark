    "Each check-in adds your ratings to Health. Editing a day replaces what Tidemark wrote for it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Check-in fügt deine Bewertungen zu Health hinzu. Wenn du einen Tag bearbeitest, wird ersetzt, was Tidemark dafür geschrieben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each check-in adds your ratings to Health. Editing a day replaces what Tidemark wrote for it."
