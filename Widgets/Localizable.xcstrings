    "Everything moves to Recently deleted for %lld days, on this iPhone and in your backup. You can bring it back from there.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt flyttes til For nylig slettet i %lld dage, på denne iPhone og i din sikkerhedskopi. Derfra kan du hente det tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles kommt für %lld Tage in Zuletzt gelöscht, auf diesem iPhone und in deinem Backup. Von dort kannst du es zurückholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything moves to Recently deleted for %lld days, on this iPhone and in your backup. You can bring it back from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo pasa a Eliminado recientemente durante %lld días, en este iPhone y en tu copia. Desde ahí puedes recuperarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki siirtyy Äskettäin poistetut -kohtaan %lld päiväksi, tässä iPhonessa ja varmuuskopiossasi. Voit palauttaa sen sieltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout passe dans Supprimés récemment pendant %lld jours, sur cet iPhone et dans votre sauvegarde. Vous pourrez tout récupérer depuis là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto va in Eliminati di recente per %lld giorni, su questo iPhone e nel backup. Da lì puoi recuperarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて「最近削除した項目」に%lld日間移ります（このiPhoneとバックアップの両方）。そこから戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목이 이 iPhone과 백업에서 %lld일 동안 최근 삭제된 항목으로 옮겨져요. 거기서 되돌릴 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt flyttes til Nylig slettet i %lld dager, på denne iPhonen og i sikkerhetskopien. Derfra kan du hente det tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gaat %lld dagen naar Recent verwijderd, op deze iPhone en in je back-up. Daar kun je het terughalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko trafi do Ostatnio usuniętych na %lld dni, na tym iPhonie i w kopii zapasowej. Stamtąd możesz to przywrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo vai para Apagados recentemente por %lld dias, neste iPhone e no seu backup. Você pode recuperar de lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все попадет в «Недавно удаленные» на %lld дн., на этом iPhone и в резервной копии. Оттуда все можно вернуть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt flyttas till Nyligen raderat i %lld dagar, på den här iPhonen och i din säkerhetskopia. Därifrån kan du ta tillbaka det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey %lld gün boyunca bu iPhone'da ve yedeğinde Son Silinenler'e taşınır. Oradan geri getirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容会在这台 iPhone 和你的备份中移到“最近删除”，保留 %lld 天。你可以从那里恢复。"
          }
        }
      }
    },
