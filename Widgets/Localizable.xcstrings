              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Notez comment s’est sentie votre journée pour votre %lld symptôme. Cela prend environ 30 secondes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Notez comment s’est sentie votre journée pour vos %lld symptômes. Cela prend environ 30 secondes."
