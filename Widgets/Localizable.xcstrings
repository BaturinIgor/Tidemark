        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can take a minute on a new iPhone. Keep the app open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede tardar un minuto en un iPhone nuevo. Mantén la app abierta."
