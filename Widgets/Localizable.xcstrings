    "Shown on your report so your doctor sees everything you take. We never suggest medicines or doses.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises i din rapport, så lægen ser alt, hvad du tager. Vi foreslår aldrig medicin eller doser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht in deinem Bericht, damit deine Ärztin oder dein Arzt alles sieht, was du nimmst. Wir schlagen nie Medikamente oder Dosierungen vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown on your report so your doctor sees everything you take. We never suggest medicines or doses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en tu informe para que tu médico vea todo lo que tomas. Nunca sugerimos medicamentos ni dosis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy raportissasi, jotta lääkäri näkee kaiken, mitä käytät. Emme koskaan ehdota lääkkeitä tai annoksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Figure sur votre rapport pour que votre médecin voie tout ce que vous prenez. Nous ne suggérons jamais de médicaments ni de doses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare nel resoconto, così il medico vede tutto ciò che prendi. Non suggeriamo mai farmaci o dosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "服用しているものすべてを医師が把握できるよう、レポートに載ります。薬や用量を提案することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용하는 모든 것을 의사가 볼 수 있도록 리포트에 표시돼요. 약이나 용량을 제안하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises i rapporten slik at legen ser alt du tar. Vi foreslår aldri medisiner eller doser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat in je rapport, zodat je arts alles ziet wat je gebruikt. We stellen nooit medicijnen of doseringen voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widoczne w raporcie, żeby lekarz widział wszystko, co przyjmujesz. Nigdy nie sugerujemy leków ani dawek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no seu relatório para o médico ver tudo o que você toma. Nunca sugerimos medicamentos nem doses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается в отчете, чтобы врач видел все, что вы принимаете. Мы никогда не предлагаем лекарства или дозы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas i din rapport så att läkaren ser allt du tar. Vi föreslår aldrig läkemedel eller doser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doktorun kullandığın her şeyi görsün diye raporunda yer alır. Asla ilaç veya doz önermeyiz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会显示在报告中，让医生了解你正在使用的一切。我们从不建议药物或剂量。"
          }
        }
      }
    },
