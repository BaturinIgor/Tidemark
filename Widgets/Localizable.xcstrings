    "We will have your report ready the day before. Two weeks of check-ins is enough for a useful picture.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har din rapport klar dagen før. To ugers registreringer er nok til et brugbart billede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben deinen Bericht am Tag davor fertig. Zwei Wochen Check-ins reichen für ein brauchbares Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will have your report ready the day before. Two weeks of check-ins is enough for a useful picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tendremos tu informe listo el día antes. Dos semanas de registros bastan para una imagen útil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporttisi on valmis edellisenä päivänä. Kahden viikon kirjaukset riittävät hyödylliseen kuvaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rapport sera prêt la veille. Deux semaines de suivi suffisent pour avoir une image utile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il resoconto sarà pronto il giorno prima. Due settimane di registrazioni bastano per un quadro utile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートは前日までに用意します。2週間分の記録があれば役立つ全体像になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리포트는 전날까지 준비해 둘게요. 2주간의 기록이면 유용한 그림이 돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har rapporten klar dagen før. To uker med registreringer er nok til et nyttig bilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben je rapport de dag ervoor klaar. Twee weken check-ins is genoeg voor een bruikbaar beeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raport będzie gotowy dzień wcześniej. Dwa tygodnie wpisów wystarczą, by obraz był przydatny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu relatório vai estar pronto na véspera. Duas semanas de registros bastam para um panorama útil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчет будет готов накануне. Двух недель отметок достаточно для полезной картины."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har din rapport klar dagen före. Två veckors incheckningar räcker för en användbar bild."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporunu bir gün önceden hazır edeceğiz. İki haftalık kayıt, işe yarar bir tablo için yeterli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会在就诊前一天准备好报告。两周的记录就足以形成有用的整体情况。"
          }
        }
      }
    },
    "We will mark this visit on your charts so the next report shows before and after.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi markerer besøget i dine diagrammer, så næste rapport viser før og efter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir markieren diesen Termin in deinen Diagrammen, damit der nächste Bericht ein Vorher und Nachher zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will mark this visit on your charts so the next report shows before and after."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcaremos esta cita en tus gráficos para que el próximo informe muestre el antes y el después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitsemme tämän käynnin kaavioihisi, jotta seuraava raportti näyttää tilanteen ennen ja jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous marquerons ce rendez-vous sur vos graphiques pour que le prochain rapport montre l’avant et l’après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segneremo questa visita nei grafici, così il prossimo resoconto mostrerà il prima e il dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この受診日をグラフに印として付け、次のレポートで前後がわかるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 진료를 차트에 표시해 다음 리포트에서 전후를 보여 줄게요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi markerer denne timen i diagrammene dine, slik at neste rapport viser før og etter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We markeren dit bezoek in je grafieken, zodat het volgende rapport het verschil voor en na laat zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczymy tę wizytę na wykresach, żeby następny raport pokazał, jak było przed i po."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos marcar esta consulta nos seus gráficos para o próximo relatório mostrar o antes e o depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отметим этот прием на графиках, чтобы следующий отчет показал, что было до и после."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi markerar besöket i dina diagram så att nästa rapport visar före och efter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ziyareti grafiklerinde işaretleyeceğiz; böylece sonraki rapor öncesini ve sonrasını gösterecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会在图表上标记这次就诊，让下一份报告显示前后对比。"
          }
        }
      }
    },
