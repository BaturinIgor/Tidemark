        }
      }
    },
    "Nothing here. Deleted days stay for %lld days.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her er intet. Slettede dage gemmes i %lld dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist nichts. Gelöschte Tage bleiben %lld Tage erhalten."
