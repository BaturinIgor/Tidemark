                  "state": "translated",
                  "value": "Valuta com’è andato oggi il tuo %lld sintomo. Ci vogliono circa 30 secondi."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Valuta com’è andata oggi per i tuoi %lld sintomi. Ci vogliono circa 30 secondi."
