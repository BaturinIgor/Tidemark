    "Stored on this iPhone and in your own iCloud, encrypted. We never see it. No ads, no data sales.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem iPhone und verschlüsselt in deiner eigenen iCloud gespeichert. Wir sehen es nie. Keine Werbung, kein Datenverkauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored on this iPhone and in your own iCloud, encrypted. We never see it. No ads, no data sales."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardados en este iPhone y en tu propio iCloud, cifrados. Nunca los vemos. Sin anuncios, sin venta de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrées sur cet iPhone et dans votre propre iCloud, chiffrées. Nous ne les voyons jamais. Pas de pub, pas de revente de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvati su questo iPhone e nel tuo iCloud, cifrati. Noi non li vediamo mai. Niente pubblicità, nessuna vendita di dati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen op deze iPhone en versleuteld in je eigen iCloud. Wij zien het nooit. Geen advertenties, geen verkoop van gegevens."
          }
        }
      }
    },
