    "Your %lld check-ins are safe on this iPhone, but they are not backed up. If you lose the phone, they are gone.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Din %lld registrering er sikker på denne iPhone, men den er ikke sikkerhedskopieret. Mister du telefonen, er den væk."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dine %lld registreringer er sikre på denne iPhone, men de er ikke sikkerhedskopieret. Mister du telefonen, er de væk."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dein %lld Check-in ist auf diesem iPhone sicher, aber nicht gesichert. Wenn du das Telefon verlierst, ist er weg."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deine %lld Check-ins sind auf diesem iPhone sicher, aber nicht gesichert. Wenn du das Telefon verlierst, sind sie weg."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your %lld check-in is safe on this iPhone, but it is not backed up. If you lose the phone, it is gone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your %lld check-ins are safe on this iPhone, but they are not backed up. If you lose the phone, they are gone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu %lld registro está a salvo en este iPhone, pero no tiene copia. Si pierdes el teléfono, se pierde."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tus %lld registros están a salvo en este iPhone, pero no tienen copia. Si pierdes el teléfono, se pierden."
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld kirjauksesi on turvassa tässä iPhonessa, mutta sitä ei ole varmuuskopioitu. Jos puhelin katoaa, se menetetään."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld kirjaustasi ovat turvassa tässä iPhonessa, mutta niitä ei ole varmuuskopioitu. Jos puhelin katoaa, ne menetetään."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Votre %lld suivi est en sécurité sur cet iPhone, mais il n’est pas sauvegardé. Si vous perdez le téléphone, il est perdu."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
