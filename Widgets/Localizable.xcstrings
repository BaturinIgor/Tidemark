    "Your doctor will weigh these numbers. The app does not say whether a treatment works.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din læge vurderer disse tal. Appen siger ikke, om en behandling virker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Ärztin oder dein Arzt bewertet diese Zahlen. Die App sagt nicht, ob eine Behandlung wirkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your doctor will weigh these numbers. The app does not say whether a treatment works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu médico valorará estos números. La app no dice si un tratamiento funciona."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lääkärisi arvioi nämä luvut. Appi ei kerro, toimiiko hoito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre médecin évaluera ces chiffres. L’app ne dit pas si un traitement fonctionne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il medico valuterà questi numeri. L’app non dice se un trattamento funziona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの数字は医師が判断します。アプリは治療が効いているかどうかを示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 숫자는 의사가 판단해요. 앱은 치료가 효과 있는지 말하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen vurderer disse tallene. Appen sier ikke om en behandling virker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je arts weegt deze cijfers. De app zegt niet of een behandeling werkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekarz oceni te liczby. Aplikacja nie mówi, czy leczenie działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu médico vai avaliar esses números. O app não diz se um tratamento funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти цифры оценит врач. Приложение не говорит, работает ли лечение."
          }
        },
        "sv": {
          "stringUnit": {
