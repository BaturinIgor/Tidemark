    "Renews automatically until you cancel in Settings › Apple ID › Subscriptions. Your data stays yours if you cancel.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk, indtil du opsiger under Indstillinger › Apple-id › Abonnementer. Dine data er stadig dine, hvis du opsiger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch, bis du in Einstellungen › Apple-ID › Abonnements kündigst. Deine Daten bleiben deine, auch wenn du kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically until you cancel in Settings › Apple ID › Subscriptions. Your data stays yours if you cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente hasta que canceles en Ajustes › ID de Apple › Suscripciones. Tus datos siguen siendo tuyos si cancelas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu automaattisesti, kunnes perut sen kohdassa Asetukset › Apple ID › Tilaukset. Tietosi pysyvät sinun, vaikka peruisit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement automatique jusqu’à résiliation dans Réglages › identifiant Apple › Abonnements. Vos données restent à vous si vous résiliez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente finché non annulli in Impostazioni › ID Apple › Abbonamenti. Se annulli, i tuoi dati restano tuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」›「Apple ID」›「サブスクリプション」で解約するまで自動更新されます。解約してもデータはあなたのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › Apple ID › 구독에서 해지할 때까지 자동으로 갱신돼요. 해지해도 데이터는 내 것이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk til du sier opp i Innstillinger › Apple-ID › Abonnementer. Dataene dine er dine også hvis du sier opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt automatisch verlengd tot je opzegt in Instellingen › Apple ID › Abonnementen. Je gegevens blijven van jou als je opzegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odnawia się automatycznie, dopóki nie anulujesz w Ustawienia › Apple ID › Subskrypcje. Po anulowaniu Twoje dane pozostają Twoje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova automaticamente até você cancelar em Ajustes › ID Apple › Assinaturas. Seus dados continuam seus se você cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается автоматически, пока вы не отмените в Настройки › Apple ID › Подписки. Если отменить, данные останутся вашими."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas automatiskt tills du avslutar i Inställningar › Apple-ID › Prenumerationer. Din data är din även om du avslutar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar › Apple Kimliği › Abonelikler'den iptal edene kadar otomatik yenilenir. İptal etsen de verilerin sana ait kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续期，直到你在“设置”›“Apple ID”›“订阅”中取消。取消后数据仍归你所有。"
          }
        }
      }
    },
