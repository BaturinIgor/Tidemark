    "Starting fresh keeps the backup in iCloud. You can restore it later from Settings.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du starter forfra, bevares sikkerhedskopien i iCloud. Du kan gendanne den senere fra Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Neuanfang bleibt das Backup in iCloud. Du kannst es später in den Einstellungen wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting fresh keeps the backup in iCloud. You can restore it later from Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar de cero conserva la copia en iCloud. Puedes restaurarla luego desde Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alusta aloittaminen säilyttää varmuuskopion iCloudissa. Voit palauttaa sen myöhemmin asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartir de zéro conserve la sauvegarde dans iCloud. Vous pourrez la restaurer plus tard depuis Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricominciare da zero mantiene il backup in iCloud. Puoi ripristinarlo più tardi da Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やり直してもiCloudのバックアップは残ります。あとから設定で復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음부터 다시 시작해도 iCloud 백업은 남아요. 나중에 설정에서 복원할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å starte på nytt beholder sikkerhetskopien i iCloud. Du kan gjenopprette den senere fra Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw beginnen bewaart de back-up in iCloud. Je kunt hem later herstellen via Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczęcie od nowa zachowuje kopię w iCloud. Możesz ją później przywrócić w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar do zero mantém o backup no iCloud. Você pode restaurá-lo depois em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если начать заново, копия в iCloud сохранится. Ее можно восстановить позже в Настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du börjar om finns säkerhetskopian kvar i iCloud. Du kan återställa den senare under Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırdan başlamak iCloud'daki yedeği korur. Daha sonra Ayarlar'dan geri yükleyebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新开始会保留 iCloud 中的备份。之后可以在“设置”中恢复。"
          }
        }
      }
    },
