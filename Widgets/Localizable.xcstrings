                  "state": "translated",
                  "value": "Оцените, как сегодня ощущались ваши %lld симптомов. Это займет около 30 секунд."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Оцените, как сегодня ощущался ваш %lld симптом. Это займет около 30 секунд."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Оцените, как сегодня ощущались ваши %lld симптома. Это займет около 30 секунд."
                }
              }
            }
          }
        },
        "sv": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Skatta hur ditt %lld besvär kändes i dag. Det tar cirka 30 sekunder."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Skatta hur dina %lld besvär kändes i dag. Det tar cirka 30 sekunder."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld belirtinin bugün nasıl hissettirdiğini puanla. Yaklaşık 30 saniye sürer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你的 %lld 个症状给今天的感受打分。大约需要 30 秒。"
          }
        }
      }
    },
    "Rate today only, not the worst day of the week. Missed a day? You can fill it in later.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurder kun i dag, ikke ugens værste dag. Har du sprunget en dag over? Du kan udfylde den senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerte nur heute, nicht den schlimmsten Tag der Woche. Einen Tag verpasst? Du kannst ihn später nachtragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate today only, not the worst day of the week. Missed a day? You can fill it in later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valora solo hoy, no el peor día de la semana. ¿Te saltaste un día? Puedes completarlo luego."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioi vain tämä päivä, ei viikon huonointa päivää. Jäikö päivä väliin? Voit täyttää sen myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez seulement aujourd’hui, pas le pire jour de la semaine. Un jour manqué ? Vous pourrez le compléter plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta solo oggi, non il giorno peggiore della settimana. Hai saltato un giorno? Puoi completarlo dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のことだけを評価してください。1週間でいちばんつらかった日ではありません。記録を忘れた日は、あとから入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘만 평가하세요. 이번 주 가장 힘든 날이 아니에요. 하루를 놓쳤나요? 나중에 채울 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurder bare i dag, ikke ukens verste dag. Gikk du glipp av en dag? Du kan fylle den inn senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beoordeel alleen vandaag, niet de slechtste dag van de week. Een dag gemist? Je kunt hem later invullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oceniaj tylko dzisiejszy dzień, nie najgorszy dzień tygodnia. Pominęłaś dzień? Możesz go uzupełnić później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalie só o dia de hoje, não o pior dia da semana. Perdeu um dia? Você pode preencher depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценивайте только сегодняшний день, а не худший за неделю. Пропустили день? Его можно заполнить позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skatta bara i dag, inte veckans värsta dag. Missat en dag? Du kan fylla i den senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bugünü puanla, haftanın en kötü gününü değil. Bir günü mü kaçırdın? Sonra doldurabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只为今天打分，而不是这周最难熬的一天。漏记了一天？之后可以补填。"
          }
        }
      }
    },
