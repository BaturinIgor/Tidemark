    "%lld selected. You will rate these each day. Change them anytime.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld valgt. Du vurderer dem hver dag. Skift dem når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ausgewählt. Du bewertest sie jeden Tag. Du kannst sie jederzeit ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld selected. You will rate these each day. Change them anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld seleccionados. Los valorarás cada día. Cámbialos cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld valittu. Arvioit ne joka päivä. Voit muuttaa niitä milloin vain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sélectionnés. Vous les noterez chaque jour. Modifiables à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld selezionati. Li valuterai ogni giorno. Puoi cambiarli quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件を選択しました。毎日これを評価します。いつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 선택했어요. 매일 평가하게 돼요. 언제든 바꿀 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld valgt. Du vurderer dem hver dag. Endre når du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gekozen. Je beoordeelt ze elke dag. Je kunt ze altijd wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrano: %lld. Będziesz je oceniać codziennie. Zmienisz je w każdej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld selecionados. Você vai avaliá-los todo dia. Mude quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано: %lld. Вы будете оценивать их каждый день. Изменить можно в любой момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld valda. Du skattar dem varje dag. Ändra när du vill."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld seçildi. Bunları her gün puanlayacaksın. İstediğin zaman değiştirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择 %lld 项。你每天都会为它们打分。随时可以更改。"
          }
        }
      }
    },
    "%lld selected. Your first %lld go in the daily check-in; change them anytime in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld valgt. De første %lld kommer med i den daglige registrering; skift dem når som helst under Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ausgewählt. Die ersten %lld kommen in den täglichen Check-in; ändern kannst du sie jederzeit in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld selected. Your first %lld go in the daily check-in; change them anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld seleccionados. Los primeros %lld van en el registro diario; cámbialos cuando quieras en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld valittu. Ensimmäiset %lld tulevat päivittäiseen kirjaukseen; voit muuttaa niitä milloin vain asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sélectionnés. Les %lld premiers vont dans le suivi quotidien ; modifiables à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld selezionati. I primi %lld vanno nella registrazione giornaliera; puoi cambiarli quando vuoi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件を選択しました。最初の%lld件が毎日の記録に入ります。設定からいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 선택했어요. 처음 %lld개가 매일 기록에 들어가요. 설정에서 언제든 바꿀 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld valgt. De første %lld kommer med i den daglige registreringen; endre når du vil i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gekozen. De eerste %lld komen in de dagelijkse check-in; wijzig ze altijd in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrano: %lld. Pierwsze %lld trafią do codziennego wpisu; zmienisz je w każdej chwili w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld selecionados. Os primeiros %lld entram no registro diário; mude quando quiser em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано: %lld. Первые %lld войдут в ежедневную отметку; изменить можно в любой момент в Настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld valda. De första %lld kommer med i den dagliga incheckningen; ändra när du vill i Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld seçildi. İlk %lld tanesi günlük kayda girer; Ayarlar'dan istediğin zaman değiştirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择 %lld 项。前 %lld 项会进入每日记录；随时可在“设置”中更改。"
          }
        }
      }
    },
