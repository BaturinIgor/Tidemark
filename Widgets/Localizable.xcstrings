    "What are my treatment options, including %@, and what are the risks for me?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke behandlinger kan jeg få, også hormonbehandling, og hvilke risici er der for mig?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Behandlungsmöglichkeiten gibt es für mich, auch eine Hormontherapie, und welche Risiken haben sie für mich?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are my treatment options, including %@, and what are the risks for me?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué opciones de tratamiento tengo, incluida la terapia hormonal, y qué riesgos tienen para mí?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä hoitovaihtoehtoja minulla on, myös hormonihoito, ja mitä riskejä niihin liittyy minulle?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelles sont mes options de traitement, y compris le traitement hormonal, et quels sont les risques pour moi ?"
          }
        },
        "it": {
