    "**Your data stays yours.** Saved on this phone and backed up, encrypted, to your own iCloud. No account, no ads, no data sales.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Deine Daten gehören dir.** Auf diesem Telefon gespeichert und verschlüsselt in deiner eigenen iCloud gesichert. Kein Konto, keine Werbung, kein Datenverkauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Your data stays yours.** Saved on this phone and backed up, encrypted, to your own iCloud. No account, no ads, no data sales."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tus datos son tuyos.** Guardados en este teléfono y con copia cifrada en tu propio iCloud. Sin cuenta, sin anuncios, sin venta de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vos données vous appartiennent.** Enregistrées sur ce téléphone et sauvegardées, chiffrées, dans votre propre iCloud. Pas de compte, pas de pub, pas de revente de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**I tuoi dati restano tuoi.** Salvati su questo telefono e copiati, cifrati, nel tuo iCloud. Nessun account, niente pubblicità, nessuna vendita di dati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Je gegevens blijven van jou.** Bewaard op deze telefoon en versleuteld geback-upt in je eigen iCloud. Geen account, geen advertenties, geen verkoop van gegevens."
          }
        }
      }
    },
