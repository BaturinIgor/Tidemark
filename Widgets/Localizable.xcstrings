          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심장 박동이 느껴짐, 빠른 맥박, 가슴 답답함"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjenner hjerteslagene, hjertet raser, trykk i brystet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hartslag voelen, hartjagen, beklemd gevoel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczuwanie bicia serca, szybkie bicie, ucisk"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentir o coração bater, coração acelerado, aperto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ощущение сердцебиения, учащенный пульс, стеснение в груди"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Känner hjärtslagen, hjärtrusning, tryck över bröstet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalp atışını hissetme, hızlı atma, sıkışma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感觉到心跳、心跳加快、胸闷"
          }
        }
      }
    },
    "Up to %lld in the daily check-in. Removing one keeps everything you logged for it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Op til %lld i den daglige registrering. Fjerner du én, bevares alt, hvad du har registreret for den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %lld im täglichen Check-in. Wenn du eine entfernst, bleibt alles erhalten, was du dafür erfasst hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to %lld in the daily check-in. Removing one keeps everything you logged for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %lld en el registro diario. Quitar uno conserva todo lo que registraste de él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enintään %lld päivittäisessä kirjauksessa. Kun poistat yhden, kaikki sille kirjattu säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %lld dans le suivi quotidien. En retirer un conserve tout ce que vous avez noté pour lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %lld nella registrazione giornaliera. Rimuoverne uno conserva tutto quello che hai registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日の記録には%lld件まで。外しても、それまでの記録はすべて残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 기록에는 최대 %lld개까지. 빼도 그동안 기록한 내용은 모두 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptil %lld i den daglige registreringen. Fjerner du én, beholdes alt du har registrert for den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal %lld in de dagelijkse check-in. Als je er een verwijdert, blijft alles bewaard wat je ervoor hebt ingevuld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %lld w codziennym wpisie. Usunięcie objawu zachowuje wszystko, co dla niego zapisałaś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %lld no registro diário. Remover um mantém tudo o que você registrou dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %lld в ежедневной отметке. Если убрать симптом, все, что вы для него отметили, сохранится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp till %lld i den dagliga incheckningen. Om du tar bort ett finns allt du loggat för det kvar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük kayıtta en fazla %lld. Birini kaldırmak, onun için kaydettiğin her şeyi korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日记录中最多 %lld 项。移除某项会保留你为它记录的全部内容。"
          }
        }
      }
    },
