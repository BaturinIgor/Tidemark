            "state": "translated",
            "value": "1回のタップで、ほてりを時刻とともに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 탭하면 시간과 함께 안면홍조를 저장해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trykk lagrer en hetetokt med klokkeslett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén tik bewaart een opvlieger met de tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno dotknięcie zapisuje uderzenie gorąca z godziną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque salva um fogacho com o horário."
          }
        },
        "ru": {
