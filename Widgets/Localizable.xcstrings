        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro de sintomas feito por mim. Não é um diagnóstico e não sugere nenhum tratamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
