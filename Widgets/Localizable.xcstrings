    "Unusual awareness of heartbeat, racing, tightness": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mærker hjerteslagene, hjertet hamrer, trykken i brystet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungewöhnliches Wahrnehmen des Herzschlags, Herzrasen, Engegefühl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unusual awareness of heartbeat, racing, tightness"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notar el latido, corazón acelerado, opresión"
          }
        },
        "fi": {
          "stringUnit": {
