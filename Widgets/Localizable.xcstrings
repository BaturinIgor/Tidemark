            "state": "translated",
            "value": "Одно касание сохраняет прилив со временем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck sparar en värmevallning med tiden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
