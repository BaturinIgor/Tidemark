    "Appointments are short. Put the most important first, and ask it at the start.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lægebesøg er korte. Sæt det vigtigste først, og spørg om det med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine sind kurz. Setze das Wichtigste an den Anfang und frag es gleich zu Beginn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appointments are short. Put the most important first, and ask it at the start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las citas son cortas. Pon lo más importante primero y pregúntalo al empezar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaanotot ovat lyhyitä. Laita tärkein ensin ja kysy se heti alussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les consultations sont courtes. Mettez le plus important en premier et posez-le dès le début."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le visite sono brevi. Metti al primo posto la cosa più importante e chiedila all’inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診察時間は短いものです。いちばん大事なことを最初に置き、始めに聞きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진료 시간은 짧아요. 가장 중요한 질문을 맨 앞에 두고 처음에 물어보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legetimer er korte. Sett det viktigste først, og spør om det med en gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspraken zijn kort. Zet het belangrijkste bovenaan en vraag het meteen aan het begin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wizyty są krótkie. Najważniejsze daj na początek i zapytaj o to od razu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultas são curtas. Coloque o mais importante primeiro e pergunte logo no início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прием короткий. Поставьте самое важное первым и спросите об этом в начале."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Besöken är korta. Sätt det viktigaste först och fråga om det direkt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Randevular kısadır. En önemlisini başa koy ve en başta sor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就诊时间很短。把最重要的问题放在最前面，一开始就问。"
          }
        }
      }
    },
