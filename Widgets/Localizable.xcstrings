          "stringUnit": {
            "state": "translated",
            "value": "Hyvin runsas vuoto ei voi odottaa vastaanottoaikaasi. Ota yhteyttä lääkäriin nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des saignements très abondants ne doivent pas attendre votre rendez-vous. Contactez votre médecin dès maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un flusso molto abbondante non deve aspettare l'appuntamento. Contatta subito il tuo medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非常に多い出血は、受診日まで待たないでください。今すぐ医師に連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출혈이 매우 많으면 진료일까지 기다리지 마세요. 지금 의사에게 연락하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svært kraftig blødning bør ikke vente til timen din. Kontakt legen nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeer hevig bloedverlies kan niet wachten tot je afspraak. Neem nu contact op met je arts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bardzo obfite krwawienie nie powinno czekać do wizyty. Skontaktuj się teraz z lekarzem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangramento muito intenso não deve esperar pela consulta. Procure seu médico agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень обильное кровотечение не должно ждать приема. Свяжитесь с врачом сейчас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mycket kraftig blödning ska inte vänta till ditt besök. Kontakta vården nu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok yoğun kanama randevunu beklememeli. Hemen doktoruna başvur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出血非常多时，不要等到预约就诊。请立即联系医生。"
          }
        }
      }
    },
