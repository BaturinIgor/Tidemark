    "Self-reported symptom record. It is not a diagnosis and does not suggest any treatment.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selvrapporterede gener. Det er ikke en diagnose og foreslår ingen behandling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst erfasste Beschwerden. Das ist keine Diagnose und schlägt keine Behandlung vor."
