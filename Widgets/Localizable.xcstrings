    "Fill them in while you remember. You can add up to %lld days back, so the report stays honest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag sie nach, solange du dich erinnerst. Du kannst bis zu %lld Tage zurück nachtragen, damit der Bericht ehrlich bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill them in while you remember. You can add up to %lld days back, so the report stays honest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétalos mientras te acuerdas. Puedes añadir hasta %lld días atrás, para que el informe sea fiel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétez-les tant que vous vous en souvenez. Vous pouvez remonter jusqu’à %lld jours, pour que le rapport reste fidèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completali finché te li ricordi. Puoi tornare indietro fino a %lld giorni, così il resoconto resta fedele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul ze in nu je het nog weet. Je kunt tot %lld dagen terug invullen, zodat het rapport eerlijk blijft."
          }
        }
      }
    },
