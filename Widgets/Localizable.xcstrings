          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én linje øverst i rapporten, med dine ord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén regel bovenaan het rapport, in je eigen woorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna linijka na początku raportu, Twoimi słowami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha no topo do relatório, com suas palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна строка в начале отчета, своими словами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En rad överst i rapporten, med dina ord."
