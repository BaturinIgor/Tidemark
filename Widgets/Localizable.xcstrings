        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Valora cómo fue hoy tu %lld síntoma. Tarda unos 30 segundos."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Valora cómo fueron hoy tus %lld síntomas. Tarda unos 30 segundos."
