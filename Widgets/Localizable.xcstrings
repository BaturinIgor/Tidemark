              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La tua %lld registrazione è al sicuro su questo iPhone, ma non ha un backup. Se perdi il telefono, è persa."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
