    "Nothing has been deleted. Your check-ins are still on this iPhone and in your iCloud backup.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet er slettet. Dine registreringer er stadig på denne iPhone og i din iCloud-sikkerhedskopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wurde gelöscht. Deine Check-ins sind noch auf diesem iPhone und in deinem iCloud-Backup."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been deleted. Your check-ins are still on this iPhone and in your iCloud backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha borrado nada. Tus registros siguen en este iPhone y en tu copia de iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole poistettu. Kirjauksesi ovat yhä tässä iPhonessa ja iCloud-varmuuskopiossasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été supprimé. Vos suivis sont toujours sur cet iPhone et dans votre sauvegarde iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato eliminato nulla. Le tue registrazioni sono ancora su questo iPhone e nel backup iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も削除されていません。記録はこのiPhoneとiCloudバックアップに残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 것은 없어요. 기록은 여전히 이 iPhone과 iCloud 백업에 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er slettet. Registreringene dine er fortsatt på denne iPhonen og i iCloud-sikkerhetskopien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets verwijderd. Je check-ins staan nog op deze iPhone en in je iCloud-back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostało usunięte. Twoje wpisy są nadal na tym iPhonie i w kopii w iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi apagado. Seus registros continuam neste iPhone e no seu backup do iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
