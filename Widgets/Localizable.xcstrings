    "Please don't delete the app, because that would remove the copy on this iPhone. Close Tidemark and open it again, restart your iPhone, or update the app from the App Store.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte lösch die App nicht, denn damit würde die Kopie auf diesem iPhone entfernt. Schließ Tidemark und öffne es erneut, starte dein iPhone neu oder aktualisiere die App im App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please don't delete the app, because that would remove the copy on this iPhone. Close Tidemark and open it again, restart your iPhone, or update the app from the App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, no borres la app, porque eso eliminaría la copia de este iPhone. Cierra Tidemark y vuelve a abrirla, reinicia el iPhone o actualiza la app desde el App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne supprimez pas l’app, car cela effacerait la copie sur cet iPhone. Fermez Tidemark et rouvrez-la, redémarrez votre iPhone ou mettez l’app à jour depuis l’App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore non eliminare l’app, perché verrebbe rimossa la copia su questo iPhone. Chiudi Tidemark e riaprila, riavvia l’iPhone o aggiorna l’app dall’App Store."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder de app alsjeblieft niet, want dan verdwijnt de kopie op deze iPhone. Sluit Tidemark en open de app opnieuw, herstart je iPhone of werk de app bij via de App Store."
          }
        }
      }
    },
