    "You can ask for a second opinion. Keep checking in and take an updated report to another %@ or a menopause clinic.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bede om en anden vurdering. Bliv ved med at registrere, og tag en opdateret rapport med til en anden læge eller en overgangsalderklinik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst eine zweite Meinung einholen. Mach weiter mit deinen Check-ins und nimm einen aktuellen Bericht zu einer anderen Praxis oder in eine Menopause-Sprechstunde mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can ask for a second opinion. Keep checking in and take an updated report to another %@ or a menopause clinic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pedir una segunda opinión. Sigue registrando y lleva un informe actualizado a otro médico o a una consulta de menopausia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit pyytää toisen mielipiteen. Jatka kirjaamista ja vie päivitetty raportti toiselle lääkärille tai vaihdevuosipoliklinikalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez demander un deuxième avis. Continuez votre suivi et apportez un rapport à jour à un autre médecin ou à une consultation ménopause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi chiedere un secondo parere. Continua a registrare e porta un resoconto aggiornato a un altro medico o a un centro per la menopausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セカンドオピニオンを求めることもできます。記録を続け、最新のレポートを別の医師や更年期外来に持っていきましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 의사의 의견을 구할 수도 있어요. 계속 기록하고 최신 리포트를 다른 의사나 갱년기 클리닉에 가져가세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan be om en ny vurdering. Fortsett å registrere og ta med en oppdatert rapport til en annen lege eller en overgangsalderpoliklinikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt om een second opinion vragen. Blijf inchecken en neem een bijgewerkt rapport mee naar een andere arts of een menopauzepoli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz poprosić o drugą opinię. Rób dalej wpisy i zabierz aktualny raport do innego lekarza lub do poradni menopauzy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode pedir uma segunda opinião. Continue registrando e leve um relatório atualizado a outro médico ou a um ambulatório de menopausa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете получить второе мнение. Продолжайте отмечать и возьмите свежий отчет к другому врачу или в центр менопаузы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan be om en second opinion. Fortsätt checka in och ta med en uppdaterad rapport till en annan läkare eller en klimakteriemottagning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci bir görüş isteyebilirsin. Kayda devam et ve güncel raporunu başka bir doktora veya menopoz polikliniğine götür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以寻求第二意见。继续记录，把最新报告带给另一位医生或更年期门诊。"
          }
        }
      }
    },
