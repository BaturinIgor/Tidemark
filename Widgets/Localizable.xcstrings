    "Started %@. Average of your daily ratings, %lld weeks before and after. 0 is none, 3 is severe.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet %@. Gennemsnit af dine daglige vurderinger, %lld uger før og efter. 0 er ingen, 3 er svær."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begonnen am %@. Durchschnitt deiner täglichen Bewertungen, %lld Wochen davor und danach. 0 ist keine, 3 ist stark."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Started %@. Average of your daily ratings, %lld weeks before and after. 0 is none, 3 is severe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezó el %@. Media de tus valoraciones diarias, %lld semanas antes y después. 0 es nada, 3 es fuerte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloitettu %@. Päivittäisten arvioidesi keskiarvo, %lld viikkoa ennen ja jälkeen. 0 on ei oireita, 3 on vaikea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencé le %@. Moyenne de vos notes quotidiennes, %lld semaines avant et après. 0 = aucun, 3 = sévère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniziato il %@. Media delle tue valutazioni giornaliere, %lld settimane prima e dopo. 0 è nessuno, 3 è forte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始：%@。毎日の評価の平均（前後%lld週間）。0はなし、3は強い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 시작. 하루 평가의 평균, 전후 %lld주. 0은 없음, 3은 심함."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet %@. Gjennomsnitt av de daglige vurderingene dine, %lld uker før og etter. 0 er ingen, 3 er kraftig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestart op %@. Gemiddelde van je dagelijkse scores, %lld weken ervoor en erna. 0 is geen, 3 is ernstig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od %@. Średnia Twoich codziennych ocen, tygodnie przed i po: %lld. 0 to brak, 3 to silne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começou em %@. Média das suas avaliações diárias, %lld semanas antes e depois. 0 é nenhum, 3 é forte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начато %@. Среднее ваших ежедневных оценок, недель до и после: %lld. 0 — нет, 3 — сильно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Började %@. Medel av dina dagliga skattningar, %lld veckor före och efter. 0 är inga, 3 är svåra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç: %@. Günlük puanlarının ortalaması, öncesi ve sonrası %lld hafta. 0 yok, 3 şiddetli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始于 %@。每日评分的平均值，前后各 %lld 周。0 表示无，3 表示重度。"
          }
        }
      }
    },
