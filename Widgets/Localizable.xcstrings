    "Bleeding after 12 months without a period shouldn't wait for your appointment. Contact your doctor now.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blødning efter 12 måneder uden menstruation bør ikke vente til din aftale. Kontakt din læge nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blutungen nach 12 Monaten ohne Periode sollten nicht bis zum Termin warten. Wende dich jetzt an deine Ärztin oder deinen Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleeding after 12 months without a period shouldn't wait for your appointment. Contact your doctor now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sangrado después de 12 meses sin regla no debe esperar a tu cita. Contacta ya con tu médico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verenvuoto 12 kuukauden kuukautiskatkon jälkeen ei voi odottaa vastaanottoaikaasi. Ota yhteyttä lääkäriin nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des saignements après 12 mois sans règles ne doivent pas attendre votre rendez-vous. Contactez votre médecin dès maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sanguinamento dopo 12 mesi senza mestruazioni non deve aspettare l'appuntamento. Contatta subito il tuo medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月経が12か月なかった後の出血は、受診日まで待たないでください。今すぐ医師に連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12개월 동안 월경이 없다가 출혈이 있으면 진료일까지 기다리지 마세요. 지금 의사에게 연락하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blødning etter 12 måneder uten mens bør ikke vente til timen din. Kontakt legen nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloedverlies na 12 maanden zonder menstruatie kan niet wachten tot je afspraak. Neem nu contact op met je arts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krwawienie po 12 miesiącach bez miesiączki nie powinno czekać do wizyty. Skontaktuj się teraz z lekarzem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangramento depois de 12 meses sem menstruação não deve esperar pela consulta. Procure seu médico agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кровотечение после 12 месяцев без месячных не должно ждать приема. Свяжитесь с врачом сейчас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blödning efter 12 månader utan mens ska inte vänta till ditt besök. Kontakta vården nu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "12 ay adet görmedikten sonra olan kanama randevunu beklememeli. Hemen doktoruna başvur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停经 12 个月后又出血，不要等到预约就诊。请立即联系医生。"
          }
        }
      }
    },
