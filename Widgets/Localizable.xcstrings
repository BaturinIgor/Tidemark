    "The score is for your doctor to interpret. It is not a diagnosis.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoren er til din læge at fortolke. Den er ikke en diagnose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Punktzahl ist für deine Ärztin oder deinen Arzt zur Einordnung. Sie ist keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The score is for your doctor to interpret. It is not a diagnosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuación la interpreta tu médico. No es un diagnóstico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisteet ovat lääkärisi tulkittavaksi. Ne eivät ole diagnoosi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le score est à interpréter par votre médecin. Ce n’est pas un diagnostic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il punteggio va interpretato dal medico. Non è una diagnosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スコアの解釈は医師が行います。診断ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점수 해석은 의사가 해요. 진단이 아니에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Poengsummen er til for legen å tolke. Den er ikke en diagnose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De score is voor je arts om te beoordelen. Het is geen diagnose."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik interpretuje lekarz. To nie jest diagnoza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontuação é para o seu médico interpretar. Não é um diagnóstico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баллы интерпретирует врач. Это не диагноз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Poängen är till för din läkare att tolka. Den är ingen diagnos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puanı yorumlamak doktoruna düşer. Bir tanı değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "得分由医生解读。它不是诊断。"
          }
        }
