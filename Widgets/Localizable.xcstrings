        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget har raderats. Dina incheckningar finns kvar på den här iPhonen och i din iCloud-säkerhetskopia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
