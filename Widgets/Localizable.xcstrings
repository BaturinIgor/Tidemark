    "The App Store didn't respond. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store svarede ikke. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hat nicht geantwortet. Prüf deine Verbindung und versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store didn't respond. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no respondió. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ei vastannut. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas répondu. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store non ha risposto. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeから応答がありません。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store가 응답하지 않았어요. 연결을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store svarte ikke. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store reageerde niet. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nie odpowiada. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não respondeu. Verifique sua conexão e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store не ответил. Проверьте подключение и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store svarade inte. Kontrollera anslutningen och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store yanıt vermedi. Bağlantını kontrol edip yeniden dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 未响应。请检查网络连接后重试。"
          }
        }
      }
    },
    "The comparison needs %lld check-ins before and after the start date.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenligningen kræver %lld registreringer før og efter startdatoen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Vergleich braucht es %lld Check-ins vor und nach dem Startdatum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The comparison needs %lld check-ins before and after the start date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comparación necesita %lld registros antes y después de la fecha de inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertailu vaatii %lld kirjausta ennen aloituspäivää ja sen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La comparaison nécessite %lld suivis avant et après la date de début."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il confronto richiede %lld registrazioni prima e dopo la data di inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較には、開始日の前後それぞれ%lld回の記録が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교하려면 시작일 전후로 기록이 %lld회씩 필요해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenligningen trenger %lld registreringer før og etter startdatoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de vergelijking zijn %lld check-ins voor en na de startdatum nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do porównania potrzeba wpisów przed i po dacie rozpoczęcia: %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A comparação precisa de %lld registros antes e depois da data de início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сравнения нужно отметок до и после даты начала: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämförelsen behöver %lld incheckningar före och efter startdatumet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırma için başlangıç tarihinden önce ve sonra %lld kayıt gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较需要开始日期前后各 %lld 次记录。"
          }
        }
      }
    },
    "The day before, Tidemark reminds you to check your report. Nothing is shared with the practice.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen før minder Tidemark dig om at se din rapport igennem. Intet deles med klinikken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Tag davor erinnert dich Tidemark daran, deinen Bericht anzusehen. Nichts wird mit der Praxis geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day before, Tidemark reminds you to check your report. Nothing is shared with the practice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día antes, Tidemark te recuerda revisar tu informe. No se comparte nada con la consulta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edellisenä päivänä Tidemark muistuttaa tarkistamaan raporttisi. Mitään ei jaeta vastaanoton kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille, Tidemark vous rappelle de vérifier votre rapport. Rien n’est partagé avec le cabinet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno prima, Tidemark ti ricorda di controllare il resoconto. Nulla viene condiviso con l’ambulatorio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前日に、Tidemarkがレポートの確認をお知らせします。医療機関と共有されるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전날 Tidemark가 리포트를 확인하라고 알려 드려요. 병원과 공유되는 것은 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen før minner Tidemark deg på å se over rapporten. Ingenting deles med legekontoret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dag ervoor herinnert Tidemark je eraan je rapport te bekijken. Er wordt niets gedeeld met de praktijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień wcześniej Tidemark przypomni Ci o sprawdzeniu raportu. Nic nie jest udostępniane przychodni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na véspera, o Tidemark lembra você de conferir o relatório. Nada é compartilhado com o consultório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накануне Tidemark напомнит проверить отчет. Ничего не передается в клинику."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen före påminner Tidemark dig om att titta på din rapport. Inget delas med mottagningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gün önce Tidemark raporunu kontrol etmeni hatırlatır. Muayenehaneyle hiçbir şey paylaşılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就诊前一天，Tidemark 会提醒你查看报告。不会与诊所共享任何内容。"
          }
        }
      }
    },
