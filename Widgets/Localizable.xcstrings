    "Most people check in before bed. It takes 30 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste registrerer før sengetid. Det tager 30 sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten machen den Check-in vor dem Schlafengehen. Er dauert 30 Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most people check in before bed. It takes 30 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría hace el registro antes de dormir. Tarda 30 segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Useimmat kirjaavat ennen nukkumaanmenoa. Se vie 30 sekuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart font leur suivi avant de se coucher. Cela prend 30 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi tutte registrano prima di dormire. Ci vogliono 30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くの人は寝る前に記録しています。30秒で終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분 자기 전에 기록해요. 30초면 돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste registrerer før leggetid. Det tar 30 sekunder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meeste mensen doen de check-in voor het slapengaan. Het duurt 30 seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większość osób robi wpis przed snem. To zajmuje 30 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria faz o registro antes de dormir. Leva 30 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большинство отмечает перед сном. Это занимает 30 секунд."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De flesta checkar in före läggdags. Det tar 30 sekunder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoğu kişi yatmadan önce kayıt yapar. 30 saniye sürer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数人在睡前记录。只需 30 秒。"
          }
        }
      }
    },
