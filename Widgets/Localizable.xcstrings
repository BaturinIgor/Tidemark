    "A few taps. Your next report will show what changed after it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et par tryk. Din næste rapport viser, hvad der ændrede sig bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Tipps. Dein nächster Bericht zeigt, was sich danach verändert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few taps. Your next report will show what changed after it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos toques. Tu próximo informe mostrará qué cambió después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutama napautus. Seuraava raporttisi näyttää, mikä muuttui sen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques touches. Votre prochain rapport montrera ce qui a changé ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi tocchi. Il prossimo resoconto mostrerà cosa è cambiato dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数回タップするだけ。次のレポートで、その後の変化がわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 번만 탭하세요. 다음 리포트에서 그 뒤에 무엇이 달라졌는지 보여줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen få trykk. Neste rapport viser hva som endret seg etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar tikken. Je volgende rapport laat zien wat er daarna veranderde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka dotknięć. Następny raport pokaże, co zmieniło się potem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns toques. Seu próximo relatório vai mostrar o que mudou depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пара касаний. Следующий отчет покажет, что изменилось после этого."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Några tryck. Din nästa rapport visar vad som ändrades efteråt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç dokunuş. Sonraki raporun, sonrasında neyin değiştiğini gösterecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点几下即可。下一份报告会显示之后发生了哪些变化。"
          }
        }
      }
    },
