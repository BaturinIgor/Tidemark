    "11 questions, about 2 minutes. Doctors know this scale, so it goes at the top of your report.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "11 spørgsmål, cirka 2 minutter. Læger kender denne skala, så den står øverst i din rapport."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "11 Fragen, etwa 2 Minuten. Ärztinnen und Ärzte kennen diese Skala, deshalb steht sie oben in deinem Bericht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "11 questions, about 2 minutes. Doctors know this scale, so it goes at the top of your report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "11 preguntas, unos 2 minutos. Los médicos conocen esta escala, por eso va al principio de tu informe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "11 kysymystä, noin 2 minuuttia. Lääkärit tuntevat tämän asteikon, joten se on raporttisi alussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "11 questions, environ 2 minutes. Les médecins connaissent cette échelle, elle figure donc en haut de votre rapport."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "11 domande, circa 2 minuti. I medici conoscono questa scala, quindi va in cima al resoconto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "11問、約2分。医師になじみのある尺度なので、レポートの最初に載ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "11문항, 약 2분. 의사들이 아는 척도라서 리포트 맨 위에 들어가요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "11 spørsmål, omtrent 2 minutter. Leger kjenner denne skalaen, så den står øverst i rapporten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "11 vragen, ongeveer 2 minuten. Artsen kennen deze schaal, daarom staat hij bovenaan je rapport."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "11 pytań, około 2 minut. Lekarze znają tę skalę, dlatego jest na początku raportu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "11 perguntas, cerca de 2 minutos. Os médicos conhecem esta escala, por isso ela fica no topo do seu relatório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "11 вопросов, около 2 минут. Врачи знают эту шкалу, поэтому она стоит в начале отчета."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "11 frågor, cirka 2 minuter. Läkare känner till skalan, så den hamnar överst i din rapport."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "11 soru, yaklaşık 2 dakika. Doktorlar bu ölçeği bilir, bu yüzden raporunun en üstünde yer alır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "11 个问题，约 2 分钟。医生熟悉这个量表，所以它放在报告最上方。"
          }
        }
      }
    },
