    "Each check-in adds your ratings to Health. Editing a day replaces what Tidemark wrote for it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver registrering føjer dine vurderinger til Sundhed. Når du redigerer en dag, erstattes det, Tidemark skrev for den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Check-in fügt deine Bewertungen zu Health hinzu. Wenn du einen Tag bearbeitest, wird ersetzt, was Tidemark dafür geschrieben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each check-in adds your ratings to Health. Editing a day replaces what Tidemark wrote for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada registro añade tus valoraciones a Salud. Editar un día reemplaza lo que Tidemark escribió para ese día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kirjaus lisää arviosi Terveyteen. Päivän muokkaaminen korvaa sen, mitä Tidemark kirjoitti sille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque suivi ajoute vos notes à Santé. Modifier un jour remplace ce que Tidemark y a écrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni registrazione aggiunge le tue valutazioni a Salute. Modificare un giorno sostituisce quello che Tidemark ha scritto per quel giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録するたびに評価がヘルスケアに追加されます。日を編集すると、Tidemarkがその日に書いた内容が置き換わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록할 때마다 평가가 건강 앱에 추가돼요. 날짜를 수정하면 Tidemark가 그날 쓴 내용이 바뀌어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver registrering legger vurderingene dine til i Helse. Når du endrer en dag, erstattes det Tidemark skrev for den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke check-in voegt je scores toe aan Gezondheid. Een dag bewerken vervangt wat Tidemark daarvoor schreef."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wpis dodaje Twoje oceny do aplikacji Zdrowie. Edycja dnia zastępuje to, co Tidemark zapisał dla tego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada registro adiciona suas avaliações ao Saúde. Editar um dia substitui o que o Tidemark escreveu para ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая отметка добавляет ваши оценки в Здоровье. Если изменить день, то, что Tidemark записал за него, будет заменено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje incheckning lägger till dina skattningar i Hälsa. Om du ändrar en dag ersätts det Tidemark skrev för den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kayıt puanlarını Sağlık'a ekler. Bir günü düzenlemek, Tidemark'ın o gün için yazdığının yerine geçer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次记录都会把你的评分添加到“健康”。编辑某一天会替换 Tidemark 为那天写入的内容。"
          }
        }
      }
    },
